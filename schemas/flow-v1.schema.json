{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "actl workflow v1",
  "description": "Editor assistance. flow-validate additionally enforces UTF-8 byte limits, unique step IDs, CLI arguments and write verification policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "steps"
  ],
  "properties": {
    "inputs": {
      "type": "object", "maxProperties": 128,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,80}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {"default": {"type": "string", "maxLength": 16384}}
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false, "required": ["approval"],
      "properties": {"approval": {"enum": ["expiring", "once_per_run", "standing"]}}
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "type"],
      "properties": {
        "pointer": {"type": "string", "maxLength": 1024, "pattern": "^(|/.*)$", "description": "JSON Pointer relative to the successful command data, not its envelope."},
        "type": {"enum": ["string", "number", "boolean", "array", "object", "null"]},
        "max_age_ms": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615, "description": "Optional age limit from producer invocation start. Expired or unknown age blocks bound consumers; no automatic refresh."}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "bind": {
          "type": "object",
          "propertyNames": {"pattern": "^(0|[1-9][0-9]*)$"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}\\.[A-Za-z0-9_-]{1,80}$"},
          "description": "Replace an existing whole value argument by zero-based index. Only preceding scalar outputs; no interpolation or option injection."
        },
        "args": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "oneOf": [
              {"type": "string", "maxLength": 16384, "pattern": "^[^\\u0000]*$"},
              {"type": "object", "additionalProperties": false, "required": ["input"],
               "properties": {"input": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$"}}}
            ]
          }
        }
      }
    },
    "check": {
      "allOf": [
        {
          "$ref": "#/$defs/invocation"
        },
        {
          "properties": {
            "command": {
              "enum": [
                "verify",
                "wait", "verify-file", "verify-rows", "verify-owner", "verify-closed", "verify-clipboard", "verify-window"
              ]
            }
          }
        }
      ]
    },
    "condition": {
      "allOf": [
        {"$ref": "#/$defs/check"},
        {"properties": {"command": {"not": {"const": "wait"}}}}
      ]
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/invocation"},
        {"type": "object", "additionalProperties": false, "required": ["sequence"],
         "properties": {"sequence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/invocation"}}}}
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "run"
      ],
      "allOf": [
        {"not": {"required": ["when", "unless"], "properties": {"when": {"type": "object"}, "unless": {"type": "object"}}}},
        {"if": {"required": ["otherwise"], "properties": {"otherwise": {"type": "object"}}},
         "then": {"anyOf": [{"required": ["when"], "properties": {"when": {"type": "object"}}}, {"required": ["unless"], "properties": {"unless": {"type": "object"}}}]}},
        {"if": {"anyOf": [{"required": ["when"], "properties": {"when": {"type": "object"}}}, {"required": ["unless"], "properties": {"unless": {"type": "object"}}}]},
         "then": {"properties": {"outputs": {"maxProperties": 0}}}}
      ],
      "properties": {
        "when": {"anyOf": [{"$ref": "#/$defs/condition"}, {"type": "null"}]},
        "unless": {"anyOf": [{"$ref": "#/$defs/condition"}, {"type": "null"}]},
        "otherwise": {"anyOf": [{"$ref": "#/$defs/action"}, {"type": "null"}]},
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "outputs": {
          "type": "object", "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z0-9_-]{1,80}$"},
          "additionalProperties": {"$ref": "#/$defs/output"},
          "description": "Explicitly persist selected read-only run results. Contents are included in flow-status regardless of error evidence policy."
        },
        "run": {
          "oneOf": [
            {"$ref": "#/$defs/invocation"},
            {"type": "object", "additionalProperties": false, "required": ["sequence"],
             "properties": {"sequence": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/invocation"}}}}
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "type": "null"
            }
          ]
        },
        "resume_check": {
          "description": "Read-only verify/wait guard for each unfinished step reached during a resumed run, before uncertain-result verification. Must assert current target/business context.",
          "anyOf": [{"$ref": "#/$defs/check"}, {"type": "null"}]
        },
        "verify": {
          "anyOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "type": "null"
            }
          ]
        },
        "pause_before": {
          "type": "boolean",
          "default": false
        },
        "retry": {
          "enum": [
            "never",
            "read_only",
            "stale_read"
          ],
          "default": "never"
        },
        "recovery": {
          "anyOf": [{"type":"null"}, {"type":"object","additionalProperties":false,
            "required":["max_retries","timeout_ms","interval_ms"],
            "properties":{"max_retries":{"type":"integer","minimum":1,"maximum":10},
              "timeout_ms":{"type":"integer","minimum":1,"maximum":60000},
              "interval_ms":{"type":"integer","minimum":1,"maximum":60000}}}]
        },
        "on_failure": {
          "enum": [
            "pause",
            "fail"
          ],
          "default": "pause"
        },
        "evidence": {
          "enum": [
            "metadata",
            "full"
          ],
          "default": "metadata",
          "description": "Persist redacted metadata by default; full opts into saving assertion contents (8 KiB limit)."
        }
      }
    }
  }
}
